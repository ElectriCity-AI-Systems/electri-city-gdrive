FROM ubuntu:22.04@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401

ARG DEBIAN_FRONTEND=noninteractive
ARG RELEASE_PYTHON_VERSION=3.12.15
ARG RELEASE_PYTHON_SHA256=c2c4321961fab0fb999d66e0cecf521c2ab3994c7992873ea99e306c1094fd5a

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils \
        build-essential \
        ca-certificates \
        curl \
        desktop-file-utils \
        file \
        libbz2-dev \
        libegl1 \
        libffi-dev \
        libfuse2 \
        fuse3 \
        libgl1 \
        liblzma-dev \
        libreadline-dev \
        libsqlite3-dev \
        libssl-dev \
        libxkbcommon-x11-0 \
        libxcb-cursor0 \
        uuid-dev \
        xz-utils \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Compile a supported Python on the same GLIBC 2.35 baseline as the bundle.
# Keep the source version and checksum pinned instead of inheriting host Python.
RUN curl --fail --location --retry 3 \
        "https://www.python.org/ftp/python/${RELEASE_PYTHON_VERSION}/Python-${RELEASE_PYTHON_VERSION}.tar.xz" \
        --output /tmp/python.tar.xz \
    && printf '%s  %s\n' "${RELEASE_PYTHON_SHA256}" /tmp/python.tar.xz | sha256sum --check --status \
    && mkdir /tmp/python-source \
    && tar --extract --xz --file /tmp/python.tar.xz --directory /tmp/python-source --strip-components=1 \
    && cd /tmp/python-source \
    && LDFLAGS="-Wl,-rpath=/opt/electridrive-python/lib" ./configure \
        --prefix=/opt/electridrive-python --enable-shared --without-static-libpython \
    && make -j "$(nproc)" \
    && make altinstall \
    && /opt/electridrive-python/bin/python3.12 -c \
        'import bz2, ctypes, lzma, sqlite3, ssl, zlib; print("Release Python native modules OK")' \
    && rm -rf /tmp/python-source /tmp/python.tar.xz

COPY packaging/requirements-release.txt /tmp/requirements-release.txt

RUN /opt/electridrive-python/bin/python3.12 -m venv /opt/electridrive-release \
    && /opt/electridrive-release/bin/python -m pip install --no-cache-dir pip==26.2.1 \
    && /opt/electridrive-release/bin/python -m pip install \
        --no-cache-dir --requirement /tmp/requirements-release.txt

# PyInstaller needs the shared library plus the native dependencies of the Qt plugins
# that ElectriDrive ships. Keep these on the GLIBC 2.35 build baseline as well.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libasound2 \
        libbrotli1 \
        libcups2 \
        libdbus-1-3 \
        libfontconfig1 \
        libfreetype6 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libpulse0 \
        libwayland-cursor0 \
        libwayland-egl1 \
        libxcomposite1 \
        libxdamage1 \
        libxkbfile1 \
        libxrandr2 \
        libxtst6 \
        libxcb-icccm4 \
        libxcb-keysyms1 \
        libxcb-shape0 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/electridrive-release/bin:${PATH}"
WORKDIR /src
