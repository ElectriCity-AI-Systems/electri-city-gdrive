FROM ubuntu:22.04@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils \
        ca-certificates \
        desktop-file-utils \
        file \
        libegl1 \
        libfuse2 \
        fuse3 \
        libgl1 \
        libxkbcommon-x11-0 \
        libxcb-cursor0 \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY packaging/requirements-release.txt /tmp/requirements-release.txt

RUN python3 -m venv /opt/electridrive-release \
    && /opt/electridrive-release/bin/python -m pip install --no-cache-dir pip==26.2.1 \
    && /opt/electridrive-release/bin/python -m pip install \
        --no-cache-dir --requirement /tmp/requirements-release.txt

# PyInstaller needs the shared library plus the native dependencies of the Qt plugins
# that ElectriDrive ships. Keep these on the GLIBC 2.35 build baseline as well.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libasound2 \
        libbrotli1 \
        libcups2 \
        libdbus-1-3 \
        libfontconfig1 \
        libfreetype6 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libpulse0 \
        libpython3.10 \
        libwayland-cursor0 \
        libwayland-egl1 \
        libxcomposite1 \
        libxdamage1 \
        libxkbfile1 \
        libxrandr2 \
        libxtst6 \
        libxcb-icccm4 \
        libxcb-keysyms1 \
        libxcb-shape0 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/electridrive-release/bin:${PATH}"
WORKDIR /src
