[Unit]
Description=ElectriDrive Selected Folder Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Edit these paths to where you cloned the repo (the folder containing app.py).
WorkingDirectory=%h/electri-city-gdrive
Environment="PATH=%h/electri-city-gdrive/.venv/bin:/usr/local/bin:/usr/bin"
ExecStart=/usr/bin/env python -m electridrive.cli sync-configured
Nice=10
IOSchedulingClass=best-effort

[Install]
WantedBy=default.target
